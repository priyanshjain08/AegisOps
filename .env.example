# Copy to .env and replace every CHANGE_ME. Never commit .env.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aegisops
DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME@postgres:5432/aegisops
REDIS_URL=redis://redis:6379/0
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
# AI provider: none | openai | anthropic  (keys stay on the backend only)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
MAX_UPLOAD_MB=25
DEMO_MODE=true
